[Unit]
Description=PRISMA - Puente de Impresión Térmica
Documentation=https://github.com/bayalad7/prisma/blob/main/docs/instalacion.md
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=300
StartLimitBurst=10

[Service]
Type=simple
User=prisma
Group=prisma
ExecStart=/usr/bin/prisma servicio ejecutar
Restart=on-failure
RestartSec=5
StateDirectory=prisma
StateDirectoryMode=0750
LogsDirectory=prisma
LogsDirectoryMode=0750
AmbientCapabilities=CAP_NET_BIND_SERVICE
NoNewPrivileges=true
ProtectSystem=full
ProtectHome=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
