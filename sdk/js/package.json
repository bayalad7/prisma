{
  "name": "@bayalad7/prisma",
  "version": "0.2.0",
  "description": "SDK para imprimir tickets en un puente PRISMA desde el navegador o Node.js",
  "keywords": ["prisma", "impresora", "ticket", "escpos", "punto de venta", "pos", "thermal printer"],
  "homepage": "https://github.com/bayalad7/prisma/tree/main/sdk/js",
  "repository": { "type": "git", "url": "git+https://github.com/bayalad7/prisma.git", "directory": "sdk/js" },
  "bugs": "https://github.com/bayalad7/prisma/issues",
  "license": "Apache-2.0",
  "main": "./dist/prisma.umd.js",
  "module": "./dist/prisma.mjs",
  "types": "./dist/prisma.umd.d.ts",
  "unpkg": "./dist/prisma.umd.js",
  "jsdelivr": "./dist/prisma.umd.js",
  "exports": {
    ".": {
      "import": { "types": "./dist/prisma.d.mts", "default": "./dist/prisma.mjs" },
      "require": { "types": "./dist/prisma.umd.d.ts", "default": "./dist/prisma.umd.js" }
    },
    "./package.json": "./package.json"
  },
  "files": ["dist", "README.md"],
  "sideEffects": false,
  "engines": { "node": ">=18" },
  "scripts": {
    "construir": "node scripts/construir.mjs",
    "test": "node scripts/construir.mjs --verificar && node --test \"test/*.test.mjs\"",
    "tipos": "tsc --noEmit --strict --module nodenext --moduleResolution nodenext --target es2022 test/tipos.mts test/tipos-cjs.cts",
    "prepublishOnly": "npm test"
  },
  "devDependencies": {
    "typescript": "^5.6.0"
  }
}
